const mechanisms = [
  {
    method: 'Chemical precipitation',
    action: 'Converts a dissolved compound into an insoluble solid via a reagent',
    fate: 'Solid phase, concentrated in clarifier underflow',
    residual: 'Sludge — requires dewatering, characterization, disposal',
    destroys: 'No',
  },
  {
    method: 'Filtration',
    action: 'Physically retains solids on or within a medium',
    fate: 'Retained on spent media or returned in backwash',
    residual: 'Spent filter media, or a backwash stream re-entering the train as new load',
    destroys: 'No',
  },
  {
    method: 'Adsorption (e.g. activated carbon)',
    action: 'Compounds bind to a high-surface-area medium; capacity is finite',
    fate: 'Bound to medium until breakthrough',
    residual: 'Spent medium holding a concentrated inventory — disposal or regeneration',
    destroys: 'No',
  },
  {
    method: 'Ion exchange',
    action: 'Target ions swap onto a resin',
    fate: 'Stripped into regenerant during regeneration',
    residual: 'Concentrated brine — smaller volume, higher concentration',
    destroys: 'No',
  },
  {
    method: 'High-temperature thermal destruction',
    action: 'Breaks molecular bonds at sustained high temperature',
    fate: 'Converted to different, typically simpler compounds',
    residual: 'Combustion byproducts and ash; off-gas handling required',
    destroys: 'Yes',
  },
];

const fluorideStages = [
  { n: 1, stage: 'Calcium reagent addition', purpose: 'Supplies calcium to react with dissolved fluoride' },
  { n: 2, stage: 'pH adjustment', purpose: 'Holds the reaction inside its effective pH window' },
  { n: 3, stage: 'Coagulation', purpose: 'Destabilizes fine precipitate so particles can join' },
  { n: 4, stage: 'Flocculation', purpose: 'Grows settleable floc from destabilized particles' },
  { n: 5, stage: 'Clarification', purpose: 'Separates solids; fluoride leaves as calcium fluoride in underflow' },
  { n: 6, stage: 'Polishing', purpose: 'Captures residual solids ahead of discharge or reclaim' },
  { n: 7, stage: 'Sludge handling', purpose: 'Dewaters and characterizes the concentrated residual' },
  { n: 8, stage: 'Discharge or reclaim', purpose: 'Final verification against the applicable limit' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'Industrial Wastewater Treatment: Removal vs. Destruction',
  description:
    'Reference comparison of industrial wastewater treatment mechanisms by whether they remove (separate and concentrate) or destroy (chemically break down) a target compound, including the residual each produces.',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  author: {
    '@type': 'Organization',
    name: 'Liberty Chemical Equipment & Supply, Inc.',
    url: 'https://www.libertyces.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Liberty Chemical Equipment & Supply, Inc.',
    url: 'https://www.libertyces.com',
  },
  about: [
    'industrial wastewater treatment',
    'chemical precipitation',
    'wastewater sludge',
    'fluoride wastewater treatment',
    'ion exchange',
    'adsorption',
  ],
};
---
<DataLayout
  title="Industrial Wastewater Treatment: Removal vs. Destruction"
  description="Reference table of industrial wastewater treatment mechanisms — which remove and concentrate a compound, which actually destroy it, and what residual each one produces."
  jsonLd={jsonLd}
  canonicalPath="/treatment-removal-vs-destruction"
>
  <h1>Industrial Wastewater Treatment: Removal vs. Destruction</h1>

  <div class="tldr">
    <strong>Direct answer:</strong> Most conventional industrial wastewater treatment
    <em>removes</em> contaminants rather than <em>destroying</em> them. Chemical precipitation,
    filtration, adsorption, and ion exchange all separate a compound from the water and
    concentrate it into another phase — a sludge, a spent medium, or a brine — which the
    facility still owns and must handle. Only genuine destruction mechanisms, such as sustained
    high-temperature thermal treatment, chemically break the compound down. Meeting a discharge
    limit therefore does not mean a contaminant has been eliminated; it means the water leaving
    the site complies, while a smaller, more concentrated residual remains on site. For a free
    specification review, call James Riggins at <a href="tel:+15593955500">(559) 395-5500</a> or
    email <a href="mailto:james@libertyces.com">james@libertyces.com</a>.
  </div>

  <h2>Mechanism comparison</h2>
  <p>Each row states what the mechanism physically does, where the target compound ends up, what
  residual is produced, and whether the compound is actually destroyed.</p>

  <table>
    <thead>
      <tr>
        <th>Mechanism</th>
        <th>What it does</th>
        <th>Where the compound goes</th>
        <th>Residual produced</th>
        <th>Destroys compound?</th>
      </tr>
    </thead>
    <tbody>
      {mechanisms.map((m) => (
        <tr>
          <td>{m.method}</td>
          <td>{m.action}</td>
          <td>{m.fate}</td>
          <td>{m.residual}</td>
          <td>{m.destroys}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Worked example — fluoride / hydrofluoric acid treatment train</h2>
  <p>Fluoride wastewater treatment is the clearest worked example of removal. A calcium reagent
  reacts with dissolved fluoride to form calcium fluoride, which has far lower solubility and
  drops out of solution. The fluoride is not destroyed — it leaves the process as a solid in the
  clarifier underflow.</p>

  <table>
    <thead>
      <tr><th>Stage</th><th>Step</th><th>Purpose</th></tr>
    </thead>
    <tbody>
      {fluorideStages.map((s) => (
        <tr>
          <td>{s.n}</td>
          <td>{s.stage}</td>
          <td>{s.purpose}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Why the distinction matters in specification</h2>
  <p>Because every removal mechanism concentrates rather than eliminates, the residual stream is a
  permanent operating reality of the process — not a byproduct discovered later. Specifying a
  treatment system on discharge performance alone leaves four questions unanswered:</p>
  <ul>
    <li><strong>pH window stability</strong> — precipitation efficiency is pH-dependent, and drift
    degrades removal before any equipment fault occurs. A compliance sample can fail while every
    control screen reads normal.</li>
    <li><strong>Proof of reagent delivery</strong> — a control system logging a metering pump as
    running is a command signal, not a flow measurement. Vapor lock, lost prime, and fouled check
    valves all produce "running" with little or no delivery. Independent flow verification is what
    distinguishes a dosing loop that reports from one that proves.</li>
    <li><strong>Redundancy</strong> — single-string dosing on a compliance-critical stream converts
    one pump failure into a reportable event.</li>
    <li><strong>Residual handling</strong> — volume, characterization, and disposal path for the
    sludge, spent media, or brine the process will generate.</li>
  </ul>

  <h2>Material note</h2>
  <p>Hydrofluoric acid attacks stainless steel. Wetted paths, containment, instrumentation, and
  gaskets in fluoride/HF service are specified in fluoropolymers, other thermoplastics, or FRP —
  and must be rated for the concentration and temperature seen during upset conditions, not only
  the design basis.</p>

