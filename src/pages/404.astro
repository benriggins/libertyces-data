---
import DataLayout from '../layouts/DataLayout.astro';

const title = 'Page Not Found';
const description = 'The page you requested does not exist on data.libertyces.com.';
---
<DataLayout title={title} description={description} jsonLd={[]} canonicalPath="/404" noindex={true}>
  <h1>Page not found (404)</h1>
  <div class="tldr">
    <strong>This URL does not exist on data.libertyces.com.</strong> The page may have been renamed or removed. Start from one of the sections below.
  </div>
  <ul>
    <li><a href="/">LibertyCES Data home</a> — all datasets and sections.</li>
    <li><a href="/chemicals/">Chemical Compatibility Index</a> — material compatibility ratings by chemical.</li>
    <li><a href="/rules/">Engineering Rules</a> — equipment-selection rules: what to avoid, what to use instead, and why.</li>
    <li><a href="/topics/">Topics We Cover</a> — real engineering questions by equipment category.</li>
  </ul>
  <p>Looking for equipment guidance on a specific fluid? Request a free spec review from <a href="https://www.libertyces.com/contact-expert-guidance">LibertyCES</a>.</p>
</DataLayout>
